<mujoco model="so_arm101">
  <compiler angle="radian" meshdir="meshes" />

  <option cone="elliptic" impratio="10" />

  <asset>
    <mesh file="waveshare_mounting_plate_so101_v2.stl" />
    <mesh file="sts3215_03a_v1.stl" />
    <mesh file="motor_holder_so101_base_v1.stl" />
    <mesh file="wrist_roll_follower_so101_v1.stl" />
    <mesh file="moving_jaw_so101_v1.stl" />
    <mesh file="base_motor_holder_so101_v1.stl" />
    <mesh file="upper_arm_so101_v1.stl" />
    <mesh file="wrist_roll_pitch_so101_v2.stl" />
    <mesh file="under_arm_so101_v1.stl" />
    <mesh file="rotation_pitch_so101_v1.stl" />
    <mesh file="motor_holder_so101_wrist_v1.stl" />
    <mesh file="sts3215_03a_no_horn_v1.stl" />
    <mesh file="base_so101_v2.stl" />

    <material name="transparent_red" rgba="1 0 0 0.3" />
        <!-- 改成白色 -->
    <material name="3d_printed" rgba="0.95 0.95 0.95 1.0" specular="0.3" shininess="0.5" />
    <material name="sts3215" rgba="0.1 0.1 0.1 1" />
  </asset>

  <default>
    <default class="so_arm101">
      <joint damping="1" frictionloss="0.1" armature="0.005" />
      <position kp="50" />
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom type="mesh" group="3" material="transparent_red" />
      </default>
    </default>
  </default>

  <default>
    <default class="sts3215">
      <geom contype="0" conaffinity="0" />
      <joint damping="0.60" frictionloss="0.052" armature="0.028" />
      <!-- These gains are not a 1-to-1 mapping of the servo gains used in
           Lerobot. These position gains and forces were calculated according to
           https://github.com/Gregory119/RBE501-RL-arm-project/blob/main/gymnasium_env/README.md,
           assuming that the servo proportional gain is set to 16. -->
        <position kp="150" kv="10" forcerange="-3.35 3.35" />
    </default>

    <default class="backlash">
      <!-- +/- 0.5° of backlash -->
      <joint
        damping="0.01"
        frictionloss="0"
        armature="0.01"
        limited="true"
        range="-0.008726646259971648 0.008726646259971648"
      />
    </default>
  </default>

  <worldbody>
    <!-- Link base -->
    <camera name="env_camera" mode="fixed" pos="0.65 0.0 0.55" xyaxes="0 1 0 -0.82 0 0.57" fovy="30"/>
    <body name="base_link" childclass="so_arm101">
      <inertial
        pos="0.0137179 -5.19711e-05 0.0334843"
        mass="0.253"
        fullinertia="0.000197385 0.000234269 0.000224368 -7.91334e-07 8.55641e-06 1.67853e-07"
      />
      <geom
        class="visual"
        pos="-0.00636471 -9.94414e-05 -0.0024"
        quat="0.5 0.5 0.5 0.5"
        mesh="base_motor_holder_so101_v1"
        material="3d_printed"
      />
      <geom
        class="visual"
        pos="-0.00636471 -8.97657e-09 -0.0024"
        quat="0.5 0.5 0.5 0.5"
        mesh="base_so101_v2"
        material="3d_printed"
      />
      <geom
        class="visual"
        pos="0.0263353 -8.97657e-09 0.0437"
        quat="1 -2.85511e-16 -9.64433e-17 6.12908e-16"
        mesh="sts3215_03a_v1"
        material="sts3215"
      />
      <geom
        class="visual"
        pos="-0.0309827 -0.000199441 0.0474"
        quat="0.5 0.5 0.5 0.5"
        mesh="waveshare_mounting_plate_so101_v2"
        material="3d_printed"
      />
      <site
        group="5"
        name="baseframe"
        pos="8.67362e-19 9.55596e-18 3.46945e-18"
        quat="1 -8.17396e-19 3.78392e-17 2.22045e-16"
      />
      <!-- Link shoulder -->
      <body
        name="shoulder_link"
        pos="0.0388353 -8.97657e-09 0.0624"
        quat="3.56167e-16 1.22818e-15 -1 -4.14635e-16"
      >
        <joint
          axis="0 0 1"
          name="shoulder_pan_joint"
          type="hinge"
          range="-1.9198621771937616 1.9198621771937634"
          class="sts3215"
        />
        <inertial
          pos="-0.0307604 -1.66727e-05 -0.0252713"
          mass="0.118"
          fullinertia="9.88297e-05 9.56218e-05 2.82927e-05 8.91466e-08 -1.37275e-06 1.82491e-07"
        />
        <geom
          class="visual"
          pos="-0.0303992 0.000422241 -0.0417"
          quat="0.5 0.5 0.5 -0.5"
          mesh="sts3215_03a_v1"
          material="sts3215"
        />
        <geom
          class="collision"
          pos="-0.0303992 0.000422241 -0.0417"
          quat="0.5 0.5 0.5 -0.5"
          mesh="sts3215_03a_v1"
          material="sts3215"
        />
        <geom
          class="visual"
          pos="-0.0675992 -0.000177759 0.0158499"
          quat="0.5 0.5 -0.5 0.5"
          mesh="motor_holder_so101_base_v1"
          material="3d_printed"
        />
        <geom
          class="collision"
          pos="-0.0675992 -0.000177759 0.0158499"
          quat="0.5 0.5 -0.5 0.5"
          mesh="motor_holder_so101_base_v1"
          material="3d_printed"
        />
        <geom
          class="visual"
          pos="0.0122008 2.22413e-05 0.0464"
          quat="0.707107 -0.707107 -0 8.3163e-34"
          mesh="rotation_pitch_so101_v1"
          material="3d_printed"
        />
        <geom
          class="collision"
          pos="0.0122008 2.22413e-05 0.0464"
          quat="0.707107 -0.707107 -0 8.3163e-34"
          mesh="rotation_pitch_so101_v1"
          material="3d_printed"
        />
        <!-- Link upper_arm -->
        <body
          name="upper_arm_link"
          pos="-0.0303992 -0.0182778 -0.0542"
          quat="0.5 -0.5 -0.5 -0.5"
        >
          <joint
            axis="0 0 1"
            name="shoulder_lift_joint"
            type="hinge"
            range="-1.7453292519943224 1.7453292519943366"
            class="sts3215"
          />
          <inertial
            pos="-0.0898471 -0.00838224 0.0184089"
            mass="0.123"
            fullinertia="4.87226e-05 0.000175923 0.000170154 -2.3623e-05 -4.81272e-08 1.07156e-08"
          />
          <!-- 大臂末端的 sts3215 电机壳: 只保留视觉, 退出碰撞。
               该电机壳从连杆侧面凸出 ~2cm, 下探到桌面附近时会先于指尖撞桌子,
               把整条手臂顶偏 (实测造成 TCP 跟踪误差 12.5 mm)。
               连杆主结构 upper_arm_so101_v1 的碰撞体保留不变。 -->
          <geom
            class="visual"
            pos="-0.11257 -0.0155 0.0187"
            quat="4.56308e-16 -0.707107 0.707107 -1.37383e-16"
            mesh="sts3215_03a_v1"
            material="sts3215"
          />
          <geom
            class="visual"
            pos="-0.065085 0.012 0.0182"
            quat="0 1 0 0"
            mesh="upper_arm_so101_v1"
            material="3d_printed"
          />
          <geom
            class="collision"
            pos="-0.065085 0.012 0.0182"
            quat="0 1 0 0"
            mesh="upper_arm_so101_v1"
            material="3d_printed"
          />
          <!-- Link lower_arm -->
          <body
            name="lower_arm_link"
            pos="-0.11257 -0.028 1.73763e-16"
            quat="0.707107 -5.98613e-17 -2.58051e-17 0.707107"
          >
            <joint
              axis="0 0 1"
              name="elbow_flex_joint"
              type="hinge"
              range="-1.69 1.54"
              class="sts3215"
            />
            <inertial
              pos="-0.0980701 0.00324376 0.0182831"
              mass="0.124"
              fullinertia="3.42715e-05 0.000190583 0.00017323 8.83681e-06 1.50718e-06 -5.84455e-08"
            />
            <geom
              class="visual"
              pos="-0.0648499 -0.032 0.0182"
              quat="0 1 0 0"
              mesh="under_arm_so101_v1"
              material="3d_printed"
            />
            <geom
              class="collision"
              pos="-0.0648499 -0.032 0.0182"
              quat="0 1 0 0"
              mesh="under_arm_so101_v1"
              material="3d_printed"
            />
            <geom
              class="visual"
              pos="-0.0648499 -0.032 0.018"
              quat="3.92687e-16 -1 -1.9186e-15 -6.38378e-16"
              mesh="motor_holder_so101_wrist_v1"
              material="3d_printed"
            />
            <geom
              class="collision"
              pos="-0.0648499 -0.032 0.018"
              quat="3.92687e-16 -1 -1.9186e-15 -6.38378e-16"
              mesh="motor_holder_so101_wrist_v1"
              material="3d_printed"
            />
            <!-- 小臂末端的 sts3215 电机壳: 同上, 只保留视觉, 退出碰撞。 -->
            <geom
              class="visual"
              pos="-0.1224 0.0052 0.0187"
              quat="7.21645e-16 1.56949e-15 1 -3.33067e-16"
              mesh="sts3215_03a_v1"
              material="sts3215"
            />
            <!-- Link wrist -->
            <body
              name="wrist_link"
              pos="-0.1349 0.0052 3.62355e-17"
              quat="0.707388 0.0 0.0 -0.706825"
            >
              <joint
                axis="0 0 1"
                name="wrist_flex_joint"
                type="hinge"
                range="-1.6 1.6"
                class="sts3215"
              />
              <inertial
                pos="-0.000103312 -0.0386143 0.0281156"
                mass="0.096"
                fullinertia="4.47509e-05 3.08549e-05 2.5519e-05 2.17434e-08 -6.41776e-08 4.42475e-06"
              />
              <geom
                class="visual"
                pos="8.32667e-17 -0.0424 0.0306"
                quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_no_horn_v1"
                material="3d_printed"
              />
              <geom
                class="collision"
                pos="8.32667e-17 -0.0424 0.0306"
                quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_no_horn_v1"
                material="3d_printed"
              />
              <geom
                class="visual"
                pos="0 -0.028 0.0181"
                quat="0.5 -0.5 -0.5 -0.5"
                mesh="wrist_roll_pitch_so101_v2"
                material="3d_printed"
              />
              <geom
                class="collision"
                pos="0 -0.028 0.0181"
                quat="0.5 -0.5 -0.5 -0.5"
                mesh="wrist_roll_pitch_so101_v2"
                material="3d_printed"
              />
              <!-- Link gripper -->
              <body
                name="gripper_link"
                pos="0.0 -0.0611 0.0181"
                quat="0.000563 -0.000563 0.707388 0.706825"
              >
                <!-- 真机标定 wrist_roll: 0~4095 counts = 整整 360°;
                     原来只给 ±2.3 rad (263.6°)，比真机少 96°，已按实测改正 -->
                <joint
                  axis="0 0 1"
                  name="wrist_roll_joint"
                  type="hinge"
                  range="-3.1416 3.1416"
                  class="sts3215"
                />
                <camera name="wrist_camera" mode="fixed" fovy="30"
                  pos="-0.000099 0.061885 -0.018949"
                  xyaxes="0.999999 0.001592 -0.000001 -0.001424 0.894070 -0.447926" />
                <inertial
                  pos="0.000213627 0.000245138 -0.025187"
                  mass="0.132"
                  fullinertia="4.17373e-05 6.57962e-05 5.23538e-05 -5.08642e-07 -8.70168e-06 -7.85699e-08"
                />
                <geom
                  class="visual"
                  pos="0.0077 0.0001 -0.0234"
                  quat="0.707107 -0.707107 1.66015e-15 6.45094e-15"
                  mesh="sts3215_03a_v1"
                  material="sts3215"
                />
                <geom
                  class="collision"
                  pos="0.0077 0.0001 -0.0234"
                  quat="0.707107 -0.707107 1.66015e-15 6.45094e-15"
                  mesh="sts3215_03a_v1"
                  material="sts3215"
                  contype="8" conaffinity="1"
                />
                <geom
                  class="visual"
                  pos="8.32667e-17 -0.000218214 0.000949706"
                  quat="0 1 0 0"
                  mesh="wrist_roll_follower_so101_v1"
                  material="3d_printed"
                />
                <geom
                  class="collision"
                  pos="8.32667e-17 -0.000218214 0.000949706"
                  quat="0 1 0 0"
                  mesh="wrist_roll_follower_so101_v1"
                  material="3d_printed"
                  contype="8" conaffinity="1"
                />
                <!-- ★ 固定指指垫（2024-11 第六轮）：一片 34x2x34 mm 的平面 TPU 垫，
                     贴在药盒 +y 侧大面外 0.2 mm。位置不是拍的：按【真实到达位姿】
                     （descend 段末 TCP=23.57 mm，PD 稳态误差让手臂停在这里，而不是 IK 目标
                     的 12 mm）用 FK 反算到本 body 局部系。改动动作脚本后必须重算。
                     位掩码 (4,3)：只与药盒(bit1)与通用件(bit0)碰，与指壳(bit3)不碰。 -->
                <!-- ★ 固定指指垫（2024-11 第七轮修正）：不可见、且【贴合手指真实内表面】。
                     上一版把垫子贴在"药盒表面"，实测垫面 14 个探针点 0/14 落在手指实体内
                     —— 等于悬在指尖前方 4.7~15 mm 的一块板（用户看到的就是"指尖多了个垫子 + 缝隙"）。
                     现在按手指 mesh 的内表面 p5 平面反算局部坐标，外表面与该平面齐平、
                     向内沉 0.3 mm；rgba 全 0 => 不参与渲染。 -->
                <geom
                  name="pad_gripper_link" type="box" size="0.0250 0.0010 0.0200"
                  pos="-0.001237 -0.000128 -0.091589"
                  quat="0.741404 -0.318476 0.231482 0.543423"
                  contype="4" conaffinity="2" condim="4"
                  friction="1.2 0.01 0.0001"
                  solref="0.02 1" solimp="0.9 0.95 0.001"
                  rgba="0 0 0 0"
                />
                <site
                  group="5"
                  name="gripperframe"
                  pos="-0.0079 -0.000218121 -0.0981274"
                  quat="0.707107 -0 0.707107 -2.37788e-17"
                />
                <!-- Link jaw -->
                <body
                  name="jaw_link"
                  pos="0.0202 0.0188 -0.0234"
                  quat="0.704244 0.704246 0.063554 -0.063554"
                >
                  <!-- 恢复原始开合轴。原 axis="0 0 1" 经 body quat 变换后
                       对应夹爪的上下闭合方向，是正确的平行夹爪行为。
                       (曾误改为绕 TCP z 轴，导致开合变成水平旋转，已回退) -->
                  <joint
                    axis="0 0 1"
                    name="gripper_joint"
                    type="hinge"
                    range="0.0 2.232"
                    class="sts3215"
                  />
                  <inertial
                    pos="-0.00157495 -0.0300244 0.0192755"
                    mass="0.014"
                    fullinertia="7.71665e-06 2.20537e-06 6.16861e-06 -3.73108e-07 -6.8917e-09 -1.28269e-07"
                  />
                  <geom
                    class="visual"
                    pos="-5.55112e-17 -5.55112e-17 0.0189"
                    quat="1 -0 3.00524e-16 -2.00834e-17"
                    mesh="moving_jaw_so101_v1"
                    material="sts3215"
                  />
                  <geom
                    class="collision"
                    pos="-5.55112e-17 -5.55112e-17 0.0189"
                    quat="1 -0 3.00524e-16 -2.00834e-17"
                    mesh="moving_jaw_so101_v1"
                    material="sts3215"
                    contype="8" conaffinity="1"
                  />
                  <!-- ★ 活动指指垫（压头）：34x2x34 mm，闭合位(GRIP_SHUT=0.20)时内侧
                       过压进药盒 −y 大面 0.4 mm。★ 两侧算法别搞混：固定指是背板
                       （留 0.2 mm 让位，否则下探先撞盒顶），活动指是压头（必须过压，
                       否则合到底也夹不到 —— 实测两版就是差在这 1.6 mm 上）。 -->
                  <geom
                    name="pad_jaw_link" type="box" size="0.0250 0.0010 0.0200"
                    pos="-0.016348 -0.064197 0.021437"
                    quat="0.309705 -0.721127 0.584713 0.205353"
                    contype="4" conaffinity="2" condim="4"
                    friction="1.2 0.01 0.0001"
                    solref="0.02 1" solimp="0.9 0.95 0.001"
                    rgba="0 0 0 0"
                  />
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position
      class="sts3215"
      name="shoulder_pan_joint"
      joint="shoulder_pan_joint"
      forcerange="-3.35 3.35"
      ctrlrange="-1.91986 1.91986"
    />
    <position
      class="sts3215"
      name="shoulder_lift_joint"
      joint="shoulder_lift_joint"
      forcerange="-3.35 3.35"
      ctrlrange="-1.74533 1.74533"
    />
    <position
      class="sts3215"
      name="elbow_flex_joint"
      joint="elbow_flex_joint"
      forcerange="-3.35 3.35"
      ctrlrange="-1.69 1.54"
    />
    <position
      class="sts3215"
      name="wrist_flex_joint"
      joint="wrist_flex_joint"
      forcerange="-3.35 3.35"
      ctrlrange="-1.6 1.6"
    />
    <position
      class="sts3215"
      name="wrist_roll_joint"
      joint="wrist_roll_joint"
      forcerange="-3.35 3.35"
      ctrlrange="-3.1416 3.1416"
    />
    <position
      class="sts3215"
      name="gripper_joint"
      joint="gripper_joint"
      forcerange="-3.35 3.35"
      ctrlrange="0.0 2.232"
    />
  </actuator>

  <contact>
    <exclude body1="base_link" body2="shoulder_link" />
    <exclude body1="shoulder_link" body2="upper_arm_link" />
    <exclude body1="upper_arm_link" body2="lower_arm_link" />
    <exclude body1="lower_arm_link" body2="wrist_link" />
    <exclude body1="wrist_link" body2="gripper_link" />
    <exclude body1="gripper_link" body2="jaw_link" />
  </contact>
</mujoco>
