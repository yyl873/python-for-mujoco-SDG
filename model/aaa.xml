<mujoco model="so_arm101">
  <!-- model="so_arm101"：给这个模型起个名字，随便起，不影响物理，只在日志和调试里显示。 -->

  <!-- ================= 文件头 ================= -->

  <!-- compiler 控制 MuJoCo 怎么“读”这个文件。 -->
  <compiler angle="radian" meshdir="meshes" />
  <!-- angle="radian"：这个文件里所有角度单位是【弧度】。
       写 1.57 才是 90°；如果写 90，MuJoCo 会当成 90 弧度，姿态全错。
       你的 joint range 全是弧度值，就是因为这一行。 -->
  <!-- meshdir="meshes"：所有 <mesh file="x.stl"> 都去 meshes/ 目录下找，
       不用每个 mesh 都写完整路径。 -->

  <!-- option 控制全局物理选项。 -->
  <option cone="elliptic" impratio="10" />
  <!-- cone="elliptic"：摩擦锥形状用“椭圆锥”。
       默认是 pyramidal（多面体金字塔锥），计算快但切向有刻面误差。
       椭圆锥更接近真机橡胶/TPU 的摩擦行为。 -->
  <!-- impratio="10"：切向摩擦刚度 / 法向接触刚度 的比。
       法向要硬（防穿透），切向要稳（防滑），10 是经验值。 -->
  <!-- 这里没写 timestep，所以用默认 0.002 秒。
       没写 integrator，所以用默认 Euler(0)。
       没写 gravity，所以默认 "0 0 -9.81"。 -->

  <!-- ================= asset：网格 + 材质 ================= -->

  <!-- asset 里声明所有 STL 模型和渲染材质。纯外观，不影响物理。 -->
  <asset>
    <!-- 下面 13 个 mesh 是 3D 打印件和舵机壳的 STL 文件。
         文件名对应实物件名，不写路径因为上面 meshdir 指定了。 -->
    <mesh file="waveshare_mounting_plate_so101_v2.stl" />   <!-- 底座安装板 -->
    <mesh file="sts3215_03a_v1.stl" />                       <!-- STS3215 舵机壳（带 horn） -->
    <mesh file="motor_holder_so101_base_v1.stl" />           <!-- 肩部电机座 -->
    <mesh file="wrist_roll_follower_so101_v1.stl" />         <!-- 腕 roll 从动件 -->
    <mesh file="moving_jaw_so101_v1.stl" />                  <!-- 活动夹爪指 -->
    <mesh file="base_motor_holder_so101_v1.stl" />           <!-- 底座电机座 -->
    <mesh file="upper_arm_so101_v1.stl" />                   <!-- 大臂连杆 -->
    <mesh file="wrist_roll_pitch_so101_v2.stl" />            <!-- 腕 roll/pitch 连接件 -->
    <mesh file="under_arm_so101_v1.stl" />                   <!-- 小臂连杆 -->
    <mesh file="rotation_pitch_so101_v1.stl" />              <!-- 肩部 pitch 旋转件 -->
    <mesh file="motor_holder_so101_wrist_v1.stl" />          <!-- 腕部电机座 -->
    <mesh file="sts3215_03a_no_horn_v1.stl" />               <!-- STS3215 无 horn 版 -->
    <mesh file="base_so101_v2.stl" />                        <!-- 底座主体 -->

    <!-- 材质：只影响渲染颜色/反光，不影响物理。 -->
    <!-- rgba="1 0 0 0.3"：红=1，绿=0，蓝=0，透明度=0.3。
         这是碰撞体调试可视化用的半透明红。 -->
    <material name="transparent_red" rgba="1 0 0 0.3" />
        <!-- 改成白色 -->
    <!-- rgba="0.95 0.95 0.95 1.0"：接近白，不透明。
         specular=高光强度，shininess=高光锐度。都只是渲染。 -->
    <material name="3d_printed" rgba="0.95 0.95 0.95 1.0" specular="0.3" shininess="0.5" />
    <!-- rgba="0.1 0.1 0.1 1"：接近黑，不透明。舵机壳用。 -->
    <material name="sts3215" rgba="0.1 0.1 0.1 1" />
  </asset>

  <!-- ================= default 第一块：类 so_arm101 ================= -->

  <!-- default 是“类继承”，不是全局变量。
       这块定义了一个叫 so_arm101 的类，base_link 用 childclass="so_arm101"
       让整条链默认用这套参数。但每个 joint/actuator 又显式写了
       class="sts3215"，所以下面这套大部分会被覆盖。 -->
  <default>
    <default class="so_arm101">
      <!-- 这套 joint 默认值会被 sts3215 类的 0.60/0.052/0.028 覆盖。
           damping=1：粘性阻尼，跟速度成正比。
           frictionloss=0.1：干摩擦，不动也要用力才推得动。
           armature=0.005：电机转子惯量折到关节侧。 -->
      <joint damping="1" frictionloss="0.1" armature="0.005" />
      <!-- 这套 position 默认 kp=50 会被 sts3215 类的 kp=150 覆盖。 -->
      <position kp="50" />
      <!-- visual 类：contype=0 conaffinity=0 => 不参与碰撞，只渲染。
           group=2 是渲染分组，viewer 里可以按组开关显示。 -->
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      <!-- collision 类：group=3，半透明红，参与碰撞。
           注意这里没写 contype/conaffinity，所以用默认值 1/1，会碰。 -->
      <default class="collision">
        <geom type="mesh" group="3" material="transparent_red" />
      </default>
    </default>
  </default>

  <!-- ================= default 第二 块：类 sts3215 ================= -->

  <!-- 这块才是真正生效的参数。来源：Feetech STS3215 规格 + Lerobot 增益换算。 -->
  <default>
    <default class="sts3215">
      <!-- 该类下 geom 默认不碰（contype=0 conaffinity=0）。
           所以后面两个电机壳只写 class="visual" 就自动退出碰撞。 -->
      <geom contype="0" conaffinity="0" />
      <!-- damping=0.60：粘性阻尼，τ = -0.60 * qdot，速度越快阻力越大。
           为什么：舵机内部有油阻尼 + 反电动势。
           frictionloss=0.052：干摩擦（库仑型），大小恒定、方向与速度反向。
           为什么：减速箱有静摩擦，不动也要用力才推得动。
           armature=0.028：电机转子惯量折到关节侧。
           为什么：不加的话关节“太轻”，PD 一给就冲过头。 -->
      <joint damping="0.60" frictionloss="0.052" armature="0.028" />
      <!-- These gains are not a 1-to-1 mapping of the servo gains used in
           Lerobot. These position gains and forces were calculated according to
           https://github.com/Gregory119/RBE501-RL-arm-project/blob/main/gymnasium_env/README.md,
           assuming that the servo proportional gain is set to 16. -->
      <!-- kp=150：位置执行器内部 PD 的 P。
           内部公式：τ = kp*(target - q) - kv*qdot。
           为什么 150：跟得紧但不过冲；太小跟不动，太大振荡。
           kv=10：PD 的 D，抑制过冲。
           forcerange=±3.35：力矩上限，来自 STS3215 堵转扭矩规格。
           为什么：不截断 = 让仿真做出真机做不到的动作 = 仿真造假。
           你的 probe_contact_audit.py 会读它判“真机能不能做”。 -->
        <position kp="150" kv="10" forcerange="-3.35 3.35" />
    </default>

    <!-- 类 backlash：模拟舵机齿轮间隙 ±0.5°。
         为什么定义：为以后真实回差建模预留。
         当前没有任何 joint 写 class="backlash"，所以定义了但没启用。 -->
    <default class="backlash">
      <!-- +/- 0.5° of backlash -->
      <joint
        damping="0.01"          <!-- 回差关节的阻尼，很小 -->
        frictionloss="0"        <!-- 回差关节不设干摩擦 -->
        armature="0.01"         <!-- 回差关节的转子惯量，很小 -->
        limited="true"          <!-- 这个 range 生效 -->
        range="-0.008726646259971648 0.008726646259971648"  <!-- ±0.5° 换算成弧度 -->
      />
    </default>
  </default>

  <!-- ================= worldbody：场景 + 机械臂 ================= -->

  <!-- worldbody 是 MuJoCo 的“世界”，所有 body、joint、geom、site、camera 都在里面。
       body 是树结构，每个 body 相对父 body 定位。 -->
  <worldbody>
    <!-- Link base -->

    <!-- env_camera：环境相机，固定在世界坐标，拍桌面全景。
         和 wrist_camera 配对输入 ACT。
         mode="fixed"：相机固定不动。
         pos：相机在世界坐标的位置。
         xyaxes：前两个三元组是相机的 x 轴和 y 轴方向。
         fovy="30"：垂直视场角 30°。 -->
    <camera name="env_camera" mode="fixed" pos="0.5814 -0.0418 0.5919" xyaxes="0 1 0 -0.82 0 0.57" fovy="30"/>

    <!-- base_link：整条机械臂链的根。
         childclass="so_arm101"：所有子 body 默认继承 so_arm101 类。 -->
    <body name="base_link" childclass="so_arm101">
      <!-- inertial：物理属性，必须写，否则力矩算错。
           pos：质心相对 base_link 局部坐标的位置。
           mass：质量 0.253 kg。
           fullinertia：惯性张量 6 个数（ixx iyy izz ixy ixz iyz）。
           怎么用：m.body_mass[i]、m.body_inertia[i]、m.body_ipos[i]。 -->
      <inertial
        pos="0.0137179 -5.19711e-05 0.0334843"
        mass="0.253"
        fullinertia="0.000197385 0.000234269 0.000224368 -7.91334e-07 8.55641e-06 1.67853e-07"
      />
      <!-- 以下 4 个 geom 都是 class="visual"：只渲染，不碰。
           pos：相对 base_link 的位置。
           quat：相对 base_link 的四元数姿态。
           mesh：引用 asset 里的 STL。
           material：渲染材质。 -->
      <geom
        class="visual"                    <!-- visual 类，不碰 -->
        pos="-0.00636471 -9.94414e-05 -0.0024"   <!-- 相对位置 -->
        quat="0.5 0.5 0.5 0.5"           <!-- 四元数姿态 -->
        mesh="base_motor_holder_so101_v1" <!-- 用哪个 STL -->
        material="3d_printed"            <!-- 白色材质 -->
      />
      <geom
        class="visual"
        pos="-0.00636471 -8.97657e-09 -0.0024"
        quat="0.5 0.5 0.5 0.5"
        mesh="base_so101_v2"
        material="3d_printed"
      />
      <geom
        class="visual"
        pos="0.0263353 -8.97657e-09 0.0437"
        quat="1 -2.85511e-16 -9.64433e-17 6.12908e-16"
        mesh="sts3215_03a_v1"
        material="sts3215"               <!-- 黑色舵机壳材质 -->
      />
      <geom
        class="visual"
        pos="-0.0309827 -0.000199441 0.0474"
        quat="0.5 0.5 0.5 0.5"
        mesh="waveshare_mounting_plate_so101_v2"
        material="3d_printed"
      />
      <!-- baseframe：基座标记点。
           site 没有质量、不参与碰撞，只是一个坐标参考。
           怎么用：site_id = mj_name2id(m, mjOBJ_SITE, "baseframe")；
                   data.site_xpos[site_id] 读它在世界里的位置。 -->
      <site
        group="5"                         <!-- 渲染分组 5 -->
        name="baseframe"                  <!-- 名字，Python 里按名字找 -->
        pos="8.67362e-19 9.55596e-18 3.46945e-18"  <!-- 相对位置，基本在原点 -->
        quat="1 -8.17396e-19 3.78392e-17 2.22045e-16"  <!-- 单位四元数 -->
      />

      <!-- Link shoulder -->
      <!-- shoulder_link：肩部 body，相对 base_link 定位。
           pos：肩关节在 base_link 局部系的位置。
           quat：肩 body 相对 base 的旋转，把局部 z 轴转到竖直方向。 -->
      <body
        name="shoulder_link"
        pos="0.0388353 -8.97657e-09 0.0624"
        quat="3.56167e-16 1.22818e-15 -1 -4.14635e-16"
      >
        <!-- shoulder_pan_joint：绕 body 局部 z 轴转。
             因为 body 的 quat 把局部 z 转到了世界竖直方向，
             所以绕局部 z 转 = 绕竖直轴 pan。
             type="hinge"：转的关节（不是滑的）。
             range=±1.9199 rad = ±110°。
             class="sts3215"：用上面那套 damping/frictionloss/armature。
             怎么用：data.qpos[qpos_adr] 就是这个角。 -->
        <joint
          axis="0 0 1"                    <!-- 绕局部 z 轴 -->
          name="shoulder_pan_joint"
          type="hinge"                    <!-- 转动关节 -->
          range="-1.9198621771937616 1.9198621771937634"  <!-- ±110° -->
          class="sts3215"
        />
        <!-- shoulder 的质量 0.118 kg，质心和惯性张量。 -->
        <inertial
          pos="-0.0307604 -1.66727e-05 -0.0252713"
          mass="0.118"
          fullinertia="9.88297e-05 9.56218e-05 2.82927e-05 8.91466e-08 -1.37275e-06 1.82491e-07"
        />
        <!-- visual + collision 成对：同一 mesh 两份。
             visual 不碰，collision 碰。
             为什么成对：外观要好看，碰撞要准确，两回事。 -->
        <geom
          class="visual"
          pos="-0.0303992 0.000422241 -0.0417"
          quat="0.5 0.5 0.5 -0.5"
          mesh="sts3215_03a_v1"
          material="sts3215"
        />
        <geom
          class="collision"               <!-- collision 类，会碰 -->
          pos="-0.0303992 0.000422241 -0.0417"
          quat="0.5 0.5 0.5 -0.5"
          mesh="sts3215_03a_v1"
          material="sts3215"
        />
        <geom
          class="visual"
          pos="-0.0675992 -0.000177759 0.0158499"
          quat="0.5 0.5 -0.5 0.5"
          mesh="motor_holder_so101_base_v1"
          material="3d_printed"
        />
        <geom
          class="collision"
          pos="-0.0675992 -0.000177759 0.0158499"
          quat="0.5 0.5 -0.5 0.5"
          mesh="motor_holder_so101_base_v1"
          material="3d_printed"
        />
        <geom
          class="visual"
          pos="0.0122008 2.22413e-05 0.0464"
          quat="0.707107 -0.707107 -0 8.3163e-34"
          mesh="rotation_pitch_so101_v1"
          material="3d_printed"
        />
        <geom
          class="collision"
          pos="0.0122008 2.22413e-05 0.0464"
          quat="0.707107 -0.707107 -0 8.3163e-34"
          mesh="rotation_pitch_so101_v1"
          material="3d_printed"
        />

        <!-- Link upper_arm -->
        <!-- upper_arm_link：大臂，相对 shoulder_link 定位。 -->
        <body
          name="upper_arm_link"
          pos="-0.0303992 -0.0182778 -0.0542"
          quat="0.5 -0.5 -0.5 -0.5"
        >
          <!-- shoulder_lift_joint：绕局部 z 轴。
               这个 body 的 quat 把局部 z 转到了水平方向，
               所以绕局部 z 转 = 俯仰 lift。
               range=±1.7453 rad = ±100°。 -->
          <joint
            axis="0 0 1"
            name="shoulder_lift_joint"
            type="hinge"
            range="-1.7453292519943224 1.7453292519943366"
            class="sts3215"
          />
          <inertial
            pos="-0.0898471 -0.00838224 0.0184089"
            mass="0.123"
            fullinertia="4.87226e-05 0.000175923 0.000170154 -2.3623e-05 -4.81272e-08 1.07156e-08"
          />
          <!-- ★ 大臂末端电机壳：只有 visual，没有 collision。
               为什么：这个壳从连杆侧面凸出 ~2cm，下探到桌面附近时
               会先于指尖撞桌子，把整条手臂顶偏，实测 TCP 跟踪误差 12.5 mm。
               去掉它的碰撞后，指尖才能先到抓取位。
               面试可讲：几何模型和真实碰撞不一致的典型修复。 -->
          <geom
            class="visual"
            pos="-0.11257 -0.0155 0.0187"
            quat="4.56308e-16 -0.707107 0.707107 -1.37383e-16"
            mesh="sts3215_03a_v1"
            material="sts3215"
          />
          <!-- 大臂主结构：visual + collision 成对，碰撞保留。 -->
          <geom
            class="visual"
            pos="-0.065085 0.012 0.0182"
            quat="0 1 0 0"
            mesh="upper_arm_so101_v1"
            material="3d_printed"
          />
          <geom
            class="collision"
            pos="-0.065085 0.012 0.0182"
            quat="0 1 0 0"
            mesh="upper_arm_so101_v1"
            material="3d_printed"
          />

          <!-- Link lower_arm -->
          <body
            name="lower_arm_link"
            pos="-0.11257 -0.028 1.73763e-16"
            quat="0.707107 -5.98613e-17 -2.58051e-17 0.707107"
          >
            <!-- elbow_flex_joint：绕局部 z 轴，range -1.69 ~ 1.54 rad。 -->
            <joint
              axis="0 0 1"
              name="elbow_flex_joint"
              type="hinge"
              range="-1.69 1.54"
              class="sts3215"
            />
            <inertial
              pos="-0.0980701 0.00324376 0.0182831"
              mass="0.124"
              fullinertia="3.42715e-05 0.000190583 0.00017323 8.83681e-06 1.50718e-06 -5.84455e-08"
            />
            <geom
              class="visual"
              pos="-0.0648499 -0.032 0.0182"
              quat="0 1 0 0"
              mesh="under_arm_so101_v1"
              material="3d_printed"
            />
            <geom
              class="collision"
              pos="-0.0648499 -0.032 0.0182"
              quat="0 1 0 0"
              mesh="under_arm_so101_v1"
              material="3d_printed"
            />
            <geom
              class="visual"
              pos="-0.0648499 -0.032 0.018"
              quat="3.92687e-16 -1 -1.9186e-15 -6.38378e-16"
              mesh="motor_holder_so101_wrist_v1"
              material="3d_printed"
            />
            <geom
              class="collision"
              pos="-0.0648499 -0.032 0.018"
              quat="3.92687e-16 -1 -1.9186e-15 -6.38378e-16"
              mesh="motor_holder_so101_wrist_v1"
              material="3d_printed"
            />
            <!-- ★ 小臂末端电机壳：同上，只有 visual，退出碰撞。 -->
            <geom
              class="visual"
              pos="-0.1224 0.0052 0.0187"
              quat="7.21645e-16 1.56949e-15 1 -3.33067e-16"
              mesh="sts3215_03a_v1"
              material="sts3215"
            />

            <!-- Link wrist -->
            <body
              name="wrist_link"
              pos="-0.1349 0.0052 3.62355e-17"
              quat="0.707388 0.0 0.0 -0.706825"
            >
              <!-- wrist_flex_joint：绕局部 z 轴，range ±1.6 rad（±91.7°）。
                   这个关节就是“腕部约定冲突”里的 wrist_flex：
                   真机遥操接近张开时 +63°，仿真 -2°，差 64.7°。
                   怎么用：log_gripper_rollout.py 会打它。 -->
              <joint
                axis="0 0 1"
                name="wrist_flex_joint"
                type="hinge"
                range="-1.6 1.6"
                class="sts3215"
              />
              <inertial
                pos="-0.000103312 -0.0386143 0.0281156"
                mass="0.096"
                fullinertia="4.47509e-05 3.08549e-05 2.5519e-05 2.17434e-08 -6.41776e-08 4.42475e-06"
              />
              <geom
                class="visual"
                pos="8.32667e-17 -0.0424 0.0306"
                quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_no_horn_v1"
                material="3d_printed"
              />
              <geom
                class="collision"
                pos="8.32667e-17 -0.0424 0.0306"
                quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_no_horn_v1"
                material="3d_printed"
              />
              <geom
                class="visual"
                pos="0 -0.028 0.0181"
                quat="0.5 -0.5 -0.5 -0.5"
                mesh="wrist_roll_pitch_so101_v2"
                material="3d_printed"
              />
              <geom
                class="collision"
                pos="0 -0.028 0.0181"
                quat="0.5 -0.5 -0.5 -0.5"
                mesh="wrist_roll_pitch_so101_v2"
                material="3d_printed"
              />

              <!-- Link gripper -->
              <body
                name="gripper_link"
                pos="0.0 -0.0611 0.0181"
                quat="0.000563 -0.000563 0.707388 0.706825"
              >
                <!-- wrist_roll_joint：绕局部 z 轴，range ±π。
                     为什么是 ±π：真机标定 0~4095 counts = 360°，
                     原来只给 ±2.3 rad（263.6°），少 96°，已按实测改正。
                     roll=-90° 是 collect.py:307 的常量，实测可用窗口 ±1°。
                     怎么用：compare_release_ab.py 对比 A/B 的 roll。 -->
                <joint
                  axis="0 0 1"
                  name="wrist_roll_joint"
                  type="hinge"
                  range="-3.1416 3.1416"
                  class="sts3215"
                />
                <!-- wrist_camera：腕部相机，跟着 gripper_link 动。
                     为什么：真机 wrist 相机拍近景，和 env 相机配对输入 ACT。
                     怎么用：renderer.update_scene(data, camera=wrist_cam_id)；
                            双相机视频导出到 LeRobot v3.0。 -->
