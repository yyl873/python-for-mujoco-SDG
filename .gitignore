/videos/
/dataset/
/logs/
/inspect/
/scripts/*
!/scripts/DATA_CARD.md

# ===== 本机缓存 / 临时残留 =====
/.cache/
/.mplcache/
/.tmp-sessfix/
/.tmp_*.txt
/.scratch/
/.dsh-tmp/
/.dsh/
__pycache__/
*.py[cod]
.venv/
venv/
*.bak

# ===== RL 工作区（2026-11-20 起）=====
