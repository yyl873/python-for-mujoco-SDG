# ===== 生成数据 / 产物：不入库 =====
# 由 collect/collect.py 与 tools/run_pipeline.py 重生成，见 README
/videos/
/dataset/
/logs/
/inspect/
/scripts/*
!/scripts/DATA_CARD.md

# ===== 本机缓存 / 临时残留 =====
/.cache/
/.mplcache/
/.tmp-sessfix/
/.tmp_*.txt
/.scratch/
/.dsh-tmp/
/.dsh/
__pycache__/
*.py[cod]
.venv/
venv/
*.bak

# ===== RL 工作区（2026-11-20 起）=====
# .venv-rl：mujoco + stable-baselines3 的隔离解释器，可重建（见 docs/HANDOFF_2026-11-20_residual_rl.md）
/.venv-rl/
# rl/ckpt：SAC 权重（每个 ~0.9 MB × seed），重建需 3×30k 步训练
/rl/ckpt/
/rl/runs/
# outputs/：本机训练产物（每个 ckpt ~200 MB，重建靠训练；CPU 续跑落这里）
/outputs/

# ===== 兜底：任何漏网的大产物 =====
*.npz
*.mp4
# 例外：README 里内嵌的对比视频要入库（上面这条只是兜底拦漏网大文件）
!docs/assets/*.mp4
*.avi
*.parquet
*.pkl
*.log
# timestamped backups
*.bak.*

# DAgger 纠正数据集（可重生成）
/rl/dagger_ds/
# 语言条件数据集副本（collect/export_lerobot.py 重生成；604 MB 视频，只留脚本不留数据）
/rl/lang_ds/

# 配对采集/导出的编号清单（运行时生成）
/.lang_pair_ids*.txt
/.lang_ids.txt

# ROS2 工作区产物（真机侧 real_robot/ 只提交源码包）
/build/
/install/
/log/
real_robot/**/__pycache__/
